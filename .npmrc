# Supply-chain hardening — see docs/PLAN.md, Phase 0.
#
# ignore-scripts blocks package lifecycle scripts (preinstall/install/
# postinstall), which are the primary attack vector for compromised npm
# packages: a malicious release runs code on your machine at install time,
# before you ever import it. Tools that genuinely need a postinstall step
# (husky) are set up explicitly with a single command instead.
ignore-scripts=true

audit-level=high
fund=false
