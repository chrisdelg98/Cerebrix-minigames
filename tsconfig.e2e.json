{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    /* DOM además de Node a propósito: el test corre en Node, pero los callbacks
       de `evaluate` viajan al navegador y se ejecutan ahí. Es el único lugar del
       repo donde un archivo vive de verdad en los dos lados. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "e2e"]
}
